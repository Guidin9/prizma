{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Prizma",
  "version": "0.1.0",
  "identifier": "io.github.guidin9.prizma",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Prizma",
        "width": 1320,
        "height": 840,
        "minWidth": 1080,
        "minHeight": 720,
        "center": true,
        "visible": false,
        "decorations": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Redragon K617 Fizz ışık ve tuş stüdyosu"
  }
}
